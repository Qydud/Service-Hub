# Copy this file to .env.production on the production server.
# NEVER commit the real .env.production file.

POSTGRES_USER=servicehub
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=servicehub

SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@your-domain.kz
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Comma-separated browser origins. Replace with the real HTTPS domain.
CORS_ORIGINS=https://your-domain.kz
